{
  "apiVersion": 1,
  "contactPoints": [
    {
      "orgId": 1,
      "name": "atrium-operacao",
      "receivers": [
        {
          "uid": "atrium-operacao-discord",
          "type": "discord",
          "settings": {
            "url": "${DISCORD_WEBHOOK_URL}",
            "use_discord_username": false
          },
          "disableResolveMessage": false
        }
      ]
    }
  ],
  "deleteContactPoints": [
    {
      "orgId": 1,
      "uid": "atrium-operacao-email"
    }
  ],
  "policies": [
    {
      "orgId": 1,
      "receiver": "atrium-operacao",
      "group_by": [
        "alertname"
      ],
      "group_wait": "30s",
      "group_interval": "5m",
      "repeat_interval": "4h"
    }
  ],
  "groups": [
    {
      "orgId": 1,
      "name": "atrium",
      "folder": "Atrium",
      "interval": "1m",
      "rules": [
        {
          "uid": "atrium-api-errors",
          "title": "Erros da API",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "sum(rate(atrium_http_requests_total{status=~\"5..\"}[10m])) / sum(rate(atrium_http_requests_total[10m]))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.02
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "10m",
          "annotations": {
            "summary": "5xx acima de 2% por 10 minutos."
          },
          "labels": {
            "service": "atrium"
          },
          "isPaused": false
        },
        {
          "uid": "atrium-ai-latency",
          "title": "Latência de IA",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "prometheus",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(atrium_qa_first_token_seconds_bucket[10m])))",
                "instant": true,
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "expression": "A",
                "reducer": "last",
                "settings": {
                  "mode": "dropNN"
                }
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        3
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "noDataState": "OK",
          "execErrState": "Error",
          "for": "30m",
          "annotations": {
            "summary": "p95 do primeiro token acima de 3 s por 30 minutos."
          },
          "labels": {
            "service": "atrium"
          },
          "isPaused": false
        },
