          "client_message_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Message Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "client_message_id"
        ],
        "title": "AskRequest"
      },
      "CitationResponse": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title"
          },
          "heading": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Heading"
          },
